{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "ios": {
        "simulator": false,
        "autoIncrement": true
      },
      "android": {
        "autoIncrement": true
      },
      "developmentClient": true,
      "distribution": "internal",
      "node": "20.19.0"
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true,
        "autoIncrement": true
      },
      "env": {
        "RCT_USE_PREBUILT_RNCORE": "0"
      }
    },
    "preview": {
      "ios": {
        "autoIncrement": true
      },
      "android": {
        "autoIncrement": true
      },
      "distribution": "internal",
      "channel": "preview",
      "node": "20.19.0"
    },
    "production": {
      "ios": {
        "autoIncrement": true
      },
      "android": {
        "autoIncrement": true
      },
      "distribution": "store",
      "channel": "production",
      "node": "20.19.0",
      "env": {
        "RCT_USE_PREBUILT_RNCORE": "0"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6755971016"
      }
    }
  }
}
